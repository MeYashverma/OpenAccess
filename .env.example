# ---------------------------------------------------------------------------
# OpenAccess configuration. Copy to .env for local use; every value is optional.
# All limits are enforced per process and are deliberately conservative.
# ---------------------------------------------------------------------------

# Network
HOST=0.0.0.0
PORT=3000

# Canonical origins. Recommended on any public deployment. PUBLIC_ORIGIN is the
# address users open; CONTENT_ORIGIN optionally puts proxied pages on a separate
# hostname (stronger isolation). Must be a bare scheme://host[:port].
# PUBLIC_ORIGIN=https://openaccess.example.com
# CONTENT_ORIGIN=https://p.openaccess.example.com

# Set to 1 when a reverse proxy/load balancer terminates TLS in front of us.
TRUST_PROXY=1
# Force https:// in generated links even if X-Forwarded-Proto is missing.
FORCE_HTTPS=0
# Log one redacted line per request (never includes session tokens or URLs).
ACCESS_LOG=0

# Sessions (in-memory; a restart invalidates every session)
MAX_SESSIONS=2000
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=12

# Request/response limits
MAX_RESPONSE_MB=30
MAX_UPLOAD_MB=10
MAX_CONCURRENT_REQUESTS_PER_SESSION=12
# Process-wide ceiling for HTML/CSS being rewritten in memory. Lower it on a
# small instance; requests are asked to retry when it is exceeded.
MAX_BUFFERED_MB=128   # 0 disables the cap; only do that if you have plenty of RAM
UPSTREAM_CONNECT_TIMEOUT_MS=10000
UPSTREAM_HEADERS_TIMEOUT_MS=20000
UPSTREAM_BODY_TIMEOUT_MS=120000

# Rate limits (per process)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_IP=2400
RATE_LIMIT_PER_SESSION=1200
SESSION_CREATES_PER_HOUR=60
SESSION_CREATE_WINDOW_MINUTES=60

# Bandwidth budget. 0 means unlimited; set it if you pay for egress.
# EGRESS_LIMIT_MB_PER_HOUR=2000

# WebSockets
ENABLE_WEBSOCKETS=1
MAX_WS_MESSAGE_KB=512

# Destination policy
# Comma-separated extra ports to allow (overrides the default blocked-port list).
# ALLOWED_UPSTREAM_PORTS=80,443,8080
# Comma-separated ports to block in addition to / instead of the defaults.
# BLOCKED_UPSTREAM_PORTS=80,443
# Hosts and suffixes that may never be proxied (e.g. your own domains).
# BLOCKED_HOSTS=example.com
# BLOCKED_HOST_SUFFIXES=.internal,.corp
# NEVER enable this on a public deployment: it allows loopback, private and
# cloud-metadata addresses through the proxy.
ALLOW_PRIVATE_TARGETS=0

# Site storage shim (localStorage/IndexedDB for proxied pages)
ENABLE_SERVER_STORAGE=1
MAX_STORAGE_KB_PER_HOST=512
